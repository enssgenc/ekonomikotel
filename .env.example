# Pass these as environment variables; this file is not loaded automatically.
PORT=4173
APP_ORIGIN=http://127.0.0.1:4173
DATA_DIR=./data
# Production: NODE_ENV=production, PORT=3000, DATA_DIR=/data,
# APP_ORIGIN=https://your-canonical-domain, TRUST_PROXY=1 behind Coolify proxy.
# Never store administrator passwords here. Use npm run admin:create.

# Optional dedicated persistent backup directory (default: DATA_DIR/backups)
# BACKUP_DIR=/backups/ekonomikotel
